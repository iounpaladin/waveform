<?xml version="1.0" encoding="utf-8" ?>

<production>
    <meta>
        <name>Test</name>
    </meta>

    <data>
        <cues>
            <cue hotkey="1" id="1" name="@2.1.B.1.1">
                <reminder><![CDATA[Line 3 Scene 100 whatever]]></reminder>
                <actions reduce="sequenced">
                    <action type="play" target="#01"/>
                </actions>
            </cue>

            <cue hotkey="ESC" id="2" name="kill">
                <reminder><![CDATA[Line 4 Scene 67]]></reminder>
                <actions reduce="simultaneous">
                    <action type="kill" target="@e"/>
                </actions>
            </cue>
        </cues>
        <resources> <!-- uncompressed data only, e.g. wav -->
            <resource id="01" href="data\100hz.wav"/>
            <resource id="02" href="data\250hz.wav"/>
            <resource id="03" href="data\440hz.wav"/>
            <resource id="04" href="data\1khz.wav"/>
            <resource id="05" href="data\10khz.wav"/>
        </resources>
        <compositions>
            <composition id="#01">
                <sample type="play" target="01" preset="#1"/>
                <sample type="play" target="02" preset=""/>
                <sample type="play" target="03" preset=""/>
                <sample type="play" target="04" preset=""/>
                <sample type="play" target="05" preset="#3"/>
            </composition>
        </compositions>
        <postprocessing>
            <filters>
                <filter id="1">
                    <fader startKey="-1000" endKey="-0" keyframe="volume" startValue="1" endValue="0.75" type="cubic"/>
                </filter>
                <filter id="2">
                    <volume value="0.75"/>
                    <trim start="1000"/> <!-- unit is ms, if `start` or `end` are absent they are assumed to be the start/end of the track -->
                </filter>
                <filter id="3">
                    <peq/>
                </filter>
                <filter id="4">
                    <fader startKey="0" endKey="1000" keyframe="volume" startValue="0.75" endValue="1" type="cubic"/>
                </filter>
            </filters>
            <presets>
                <preset id="1" filters="1"/>
                <preset id="2" filters="2;3"/>
                <preset id="3" filters="4"/>
            </presets>
        </postprocessing>
    </data>
</production>