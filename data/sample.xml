<?xml version="1.0" encoding="utf-8" ?>

<production>
    <meta>
        <name>Test</name>
    </meta>

    <data>
        <cues>
            <cue hotkey="1" id="1" name="@2.1.B.1.1">
                <reminder><![CDATA[Line 3 Scene 100 whatever]]></reminder>
                <actions reduce="simultaneous">
                    <action type="play" target="#01"/>
                </actions>
            </cue>

            <cue hotkey="ESC" id="2" name="kill">
                <reminder><![CDATA[Line 4 Scene 67]]></reminder>
                <actions reduce="simultaneous">
                    <action type="kill" target="@e"/>
                </actions>
            </cue>
        </cues>
        <resources> <!-- uncompressed data only, e.g. wav -->
            <resource id="01" href="data\100hz.wav"/>
            <resource id="02" href="data\250hz.wav"/>
            <resource id="03" href="data\440hz.wav"/>
            <resource id="04" href="data\1khz.wav"/>
            <resource id="05" href="data\10khz.wav"/>
        </resources>
        <compositions>
            <composition id="#01">
                <sample type="play" target="01" filters="1"/>
                <sample type="play" target="02" filters=""/>
                <sample type="play" target="03" filters=""/>
                <sample type="play" target="04" filters=""/>
                <sample type="play" target="05" filters="4"/>
            </composition>
        </compositions>
        <processing>
            <filters>
                <filter id="1" type="fader" startKey="-1000" endKey="-0" keyframe="volume" startValue="1" endValue="0.75" fadeType="cubic"/>
                <filter id="4" type="fader" startKey="0" endKey="1000" keyframe="volume" startValue="0.75" endValue="1" fadeType="cubic" />
            </filters>
        </processing>
    </data>
</production>